DATABASE_URL=postgresql+psycopg://tradepilot:change-local-password@localhost:5432/tradepilot
# disabled: no real or fake market data. demo: explicitly synthetic quotes.
MARKET_DATA_MODE=disabled
SESSION_TTL_SECONDS=3600
WS_TICKET_TTL_SECONDS=30
QUOTE_MAX_AGE_SECONDS=15
ORDER_CHECK_TTL_SECONDS=300
# Optional browser origin allowlist; native mobile clients send no Origin.
ALLOWED_ORIGINS=[]
# Independent of Pilot; stop accepting new orders, existing orders remain active.
ORDERS_HALTED=false
# Optional absolute path to offline-trained JSON artifact. Unset means AI unavailable.
# PREDICTION_MODEL_PATH=/absolute/path/models/005930.json
# Optional personal, locally hosted ChatGPT Plus review. Explicit browser consent required.
AI_REVIEW_ENABLED=false
AI_REVIEW_LOCAL_ONLY=true
# CHATGPT_CREDENTIALS_DIR=/absolute/path/protected/chatgpt

# Optional participant web deployment with server-owned Responses API access.
# WEB_BUILD_DIR=/absolute/path/to/TradePilot/client/build/web
# ALLOWED_ORIGINS=["https://demo.example.com"]
# AI_REVIEW_PROVIDER=openai_api
# OPENAI_API_KEY=replace-with-web-key
# LOCAL_OPENAI_API_KEY=replace-with-personal-key
# OPENAI_MODEL=gpt-4.1-mini

# Read-only production KRX quotes, with TradePilot-local paper execution only.
# MARKET_DATA_MODE=kis
# KIS_APP_KEY=replace-locally
# KIS_APP_SECRET=replace-locally
# KIS_SYMBOLS=["005930","000660"]

# Namuh PLUG actual KRX quotes with local paper orders (no brokerage orders).
# MARKET_DATA_MODE=namuh
# NHPLUG_APP_KEY=replace-locally
# NHPLUG_APP_SECRET=replace-locally
# NHPLUG_SYMBOLS=["005930","000660"]
# NHPLUG_TOKEN_CACHE_DIR=.paper-market/namuh-tokens

# Toss Securities read-only market-wide rankings, quotes and 1m/1d candles.
# Credentials are kept on the server and never sent to Flutter.
# MARKET_DATA_MODE=toss
# TOSS_CLIENT_ID=tsck_live_replace-locally
# TOSS_CLIENT_SECRET=replace-locally
# TOSS_RANKING_COUNT=100

# Optional chart details. Use provider-issued keys on the server.
# NAVER_NEWS_CLIENT_ID=
# NAVER_NEWS_CLIENT_SECRET=
# DART_API_KEY=
