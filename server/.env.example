DATABASE_URL=postgresql+psycopg://tradepilot:change-local-password@localhost:5432/tradepilot
# disabled: no real or fake market data. demo: explicitly synthetic quotes.
MARKET_DATA_MODE=disabled
SESSION_TTL_SECONDS=3600
WS_TICKET_TTL_SECONDS=30
QUOTE_MAX_AGE_SECONDS=15
ORDER_CHECK_TTL_SECONDS=60
# Optional browser origin allowlist; native mobile clients send no Origin.
ALLOWED_ORIGINS=[]
# Independent of Pilot; stop accepting new orders, existing orders remain active.
ORDERS_HALTED=false
# Optional absolute path to offline-trained JSON artifact. Unset means AI unavailable.
# PREDICTION_MODEL_PATH=/absolute/path/models/005930.json
# Optional personal, locally hosted ChatGPT Plus review. Explicit browser consent required.
AI_REVIEW_ENABLED=false
AI_REVIEW_LOCAL_ONLY=true
# CHATGPT_CREDENTIALS_DIR=/absolute/path/protected/chatgpt
